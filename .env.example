# .env.example

# Full committed configuration catalog for shared-infrastructure.
#
# IMPORTANT:
# - This file MUST NOT contain real secrets.
# - Local .env SHOULD be sparse: real secrets + environment-specific overrides.
# - Docker Compose does not automatically use .env.example as its runtime env file,
#   therefore safe non-secret defaults are also defined in compose.yaml.

# Compose project identity.
COMPOSE_PROJECT_NAME=shared

# External Docker network used by application projects.
SHARED_NETWORK_NAME=ai-shared

# Safe host-binding baseline.
# The current server intentionally overrides all three values to 0.0.0.0 in .env
# because Ollama, n8n and RabbitMQ must be reachable from LAN and VPN.
# When using 0.0.0.0, host firewall rules MUST restrict source networks.
SHARED_BIND_IP=0.0.0.0
N8N_BIND_IP=0.0.0.0
RABBITMQ_BIND_IP=0.0.0.0

# Host ports.
# Container-to-container traffic on ai-shared uses internal Docker ports
# and does not depend on these host ports.
OLLAMA_HOST_PORT=11434
N8N_HOST_PORT=5678
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Pinned images. Upgrade deliberately and review release notes first.
OLLAMA_IMAGE=ollama/ollama:0.32.12
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.34.5
N8N_POSTGRES_IMAGE=postgres:16-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management

# Shared Ollama runtime limits.
# Baseline for one 24 GB GPU. Tune only after measuring workload.
OLLAMA_KEEP_ALIVE=1m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=70000
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# n8n.
TIMEZONE=UTC
N8N_DB_NAME=n8n
N8N_DB_USER=n8n

# Secret placeholders only. Real values belong in .env or process environment.
N8N_DB_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# RabbitMQ bootstrap administrator.
# Application projects SHOULD receive their own vhost/user.
RABBITMQ_DEFAULT_USER=shared_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_GENERATE_A_STRONG_PASSWORD