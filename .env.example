# .env.example

# Full committed configuration catalog for shared-infrastructure.
#
# IMPORTANT:
# - This file MUST NOT contain real secrets.
# - Local .env SHOULD be sparse:
#   real secrets + environment-specific deployment overrides.
# - Docker Compose does not automatically use .env.example as runtime env.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=shared
SHARED_NETWORK_NAME=ai-shared

COMPOSE_PROFILES=ai-vlm,ai-embedding,ai-ui

# ---------------------------------------------------------------------------
# Public host and bind addresses
# ---------------------------------------------------------------------------

SHARED_PUBLIC_HOST=CHANGE_ME_SERVER_IP_OR_DNS

SHARED_VLM_BIND_IP=0.0.0.0
SHARED_EMBEDDING_BIND_IP=0.0.0.0
OPEN_WEBUI_BIND_IP=0.0.0.0
N8N_BIND_IP=0.0.0.0
RABBITMQ_BIND_IP=0.0.0.0

SHARED_VLM_HOST_PORT=8000
SHARED_EMBEDDING_HOST_PORT=8001
OPEN_WEBUI_HOST_PORT=3000
N8N_HOST_PORT=5678
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ---------------------------------------------------------------------------
# vLLM runtime
# ---------------------------------------------------------------------------

VLLM_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_CUDA_DEVICE_ORDER=PCI_BUS_ID

HF_TOKEN=

# ---------------------------------------------------------------------------
# Shared VLM
# ---------------------------------------------------------------------------

SHARED_VLM_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct

# Use main for initial evaluation; pin an exact HF commit after acceptance.
SHARED_VLM_MODEL_REVISION=main

SHARED_VLM_MODEL_ALIAS=shared-vlm

# Request online batch-invariant inference.
# 1 = deterministic kernels/path where supported by the current vLLM/model.
# This does not replace per-request seed; both are required by the application.
SHARED_VLM_BATCH_INVARIANT=0

SHARED_VLM_GPU_DEVICES=0
SHARED_VLM_TP_SIZE=1
SHARED_VLM_DP_SIZE=1

SHARED_VLM_MAX_MODEL_LEN=8192
SHARED_VLM_GPU_MEMORY_UTILIZATION=0.90
SHARED_VLM_MAX_NUM_SEQS=8
SHARED_VLM_MAX_NUM_QUEUED_REQS=32
SHARED_VLM_MAX_NUM_QUEUED_TOKENS=32768

# ---------------------------------------------------------------------------
# Shared multimodal embedding
# ---------------------------------------------------------------------------

SHARED_EMBEDDING_MODEL_ID=Qwen/Qwen3-VL-Embedding-8B

# Use main for initial evaluation; pin an exact HF commit after acceptance.
SHARED_EMBEDDING_MODEL_REVISION=main

SHARED_EMBEDDING_MODEL_ALIAS=shared-embedding

SHARED_EMBEDDING_GPU_DEVICES=0
SHARED_EMBEDDING_TP_SIZE=1
SHARED_EMBEDDING_DP_SIZE=1

SHARED_EMBEDDING_MAX_MODEL_LEN=8192
SHARED_EMBEDDING_GPU_MEMORY_UTILIZATION=0.90
SHARED_EMBEDDING_MAX_NUM_SEQS=8
SHARED_EMBEDDING_MAX_NUM_QUEUED_REQS=32
SHARED_EMBEDDING_MAX_NUM_QUEUED_TOKENS=32768

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------

OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.3
OPEN_WEBUI_NAME="Shared AI"

OPEN_WEBUI_ENABLE_PERSISTENT_CONFIG=false

OPEN_WEBUI_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------

N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.34.5
N8N_POSTGRES_IMAGE=postgres:16-alpine

TIMEZONE=UTC

N8N_DB_NAME=n8n
N8N_DB_USER=n8n

N8N_DB_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------

RABBITMQ_IMAGE=rabbitmq:4.1-management

RABBITMQ_DEFAULT_USER=shared_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_GENERATE_A_STRONG_PASSWORD